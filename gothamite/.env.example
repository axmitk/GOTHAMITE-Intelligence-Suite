# ==============================================================================
# GOTHAMITE Configuration Environment Variables
# ==============================================================================

# Database Configuration
# SQLite connection string. In Docker, persistent volume is mounted at /app/data
DATABASE_URL=sqlite:///gothamite.db
GOTHAMITE_DB_PATH=gothamite.db

# API Service Configuration
API_BASE_URL=http://localhost:8000/api/v1
API_HOST=0.0.0.0
API_PORT=8000

# Analyst Workbench / Streamlit UI Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
